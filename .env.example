DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_COOKIES=0
# Enable only behind a trusted proxy which overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_HEADERS=0
TIME_ZONE=Europe/Madrid
# Each browser sees TokenDash in its own language (English or Spanish). This one is used
# when the browser asks for neither, and for console messages: en or es.
LANGUAGE_CODE=en
POSTGRES_DB=tokendash
POSTGRES_USER=tokendash
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# First refresh interval in minutes (15 or more). Afterwards it is changed in
# the panel: Administration → Settings.
SCRAPE_INTERVAL_MINUTES=20
# Publish the web port on the LAN (default 127.0.0.1 = this machine only). When enabled,
# add the server's IP or name to DJANGO_ALLOWED_HOSTS and DJANGO_CSRF_TRUSTED_ORIGINS.
# scripts/init_env.py does all three when it receives the IP: init_env.py 192.168.1.50
# WEB_BIND=0.0.0.0
# The official Claude Code client on the server reads Claude's subscription limits by
# itself. It authenticates with the claude.ai session stored in the private
# "claude_config" volume, created with "docker compose exec worker claude auth login".
# Do not set CLAUDE_CODE_OAUTH_TOKEN here: a "claude setup-token" is scoped to model
# requests and cannot read the quota, and the variable would override the session.
