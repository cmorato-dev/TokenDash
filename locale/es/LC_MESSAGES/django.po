#: scraper/claude_client.py:38
msgid "The server could not read the Claude quota. The last reading is kept."
msgstr "El servidor no ha podido consultar la cuota de Claude. Se conserva la última lectura."

#: scraper/claude_client.py:101
msgid "Claude Code is connected to your claude.ai account, but it publishes no subscription quotas. Your plan may not expose them."
msgstr "Claude Code está conectado a tu cuenta de claude.ai, pero no publica cuotas de suscripción. Puede que tu plan no las exponga."

#: scraper/claude_client.py:104
msgid "The server uses a token from \"claude setup-token\", which Anthropic limits to model requests and which cannot read the quota. Sign in with \"claude auth login\" on the server and remove CLAUDE_CODE_OAUTH_TOKEN from the .env."
msgstr "El servidor usa un token de \"claude setup-token\", que Anthropic limita a las peticiones al modelo y no permite consultar la cuota. Inicia sesión con \"claude auth login\" en el servidor y quita CLAUDE_CODE_OAUTH_TOKEN del .env."

#: scraper/claude_client.py:108
msgid "The server is signed in with an API key. That kind of credential publishes no subscription quotas; a claude.ai session is needed."
msgstr "El servidor está autenticado con una clave de API. Ese tipo de credencial no publica cuotas de suscripción; hace falta una sesión de claude.ai."

#: scraper/claude_client.py:111
msgid "The server is not signed in. Run \"claude auth login\" on the server to connect the claude.ai account."
msgstr "El servidor no tiene ninguna sesión iniciada. Ejecuta \"claude auth login\" en el servidor para conectar la cuenta de claude.ai."

#: scraper/claude_client.py:114
msgid "Claude Code published no subscription quotas for the connected account."
msgstr "Claude Code no publicó cuotas de suscripción para la cuenta conectada."

#: scraper/claude_client.py:115
msgid "Claude Code published no subscription quotas: the account is not connected to a claude.ai subscription."
msgstr "Claude Code no publicó cuotas de suscripción: la cuenta no está conectada con una suscripción de claude.ai."

#: scraper/claude_client.py:122
msgid "claude.ai session connected"
msgstr "Sesión de claude.ai conectada"

#: scraper/claude_client.py:123
msgid "Token from \"claude setup-token\" (cannot read the quota)"
msgstr "Token de \"claude setup-token\" (no puede leer la cuota)"

#: scraper/claude_client.py:124 scraper/claude_client.py:125
msgid "API key (publishes no quotas)"
msgstr "Clave de API (no publica cuotas)"

#: scraper/claude_client.py:126
msgid "Third-party credential (publishes no quotas)"
msgstr "Credencial de un tercero (no publica cuotas)"

#: scraper/claude_client.py:127
msgid "Not signed in"
msgstr "Sin sesión iniciada"

#: scraper/claude_client.py:130
msgid "The client's sign-in could not be checked on the server."
msgstr "No se ha podido comprobar el inicio de sesión del cliente en el servidor."

#: scraper/claude_client.py:142
msgid "Unknown sign-in method"
msgstr "Método de acceso desconocido"

#: scraper/claude_client.py:190
msgid "The official Claude Code client did not answer the usage request."
msgstr "El cliente oficial de Claude Code no respondió a la consulta de uso."

#: scraper/claude_client.py:195
msgid "Claude Code answered without usable quota windows."
msgstr "Claude Code respondió sin ventanas de cuota utilizables."

#: scraper/claude_client_views.py:49
msgid "The server has not checked the Claude session yet."
msgstr "El servidor todavía no ha comprobado la sesión de Claude."

#: scraper/claude_client_views.py:63 scraper/codex_views.py:28
msgid "Use POST."
msgstr "Utiliza POST."

#: scraper/claude_client_views.py:69 scraper/codex_views.py:35
msgid "Invalid request."
msgstr "Solicitud no válida."

#: scraper/claude_client_views.py:75
msgid "The official Claude Code client is not installed on the server. Rebuild the image or set CLAUDE_CLIENT_PATH in the .env."
msgstr "El servidor no tiene el cliente oficial de Claude Code instalado. Reconstruye la imagen o indica CLAUDE_CLIENT_PATH en el .env."

#: scraper/claude_client_views.py:83
msgid "The server is checking the claude.ai session and reading the Claude limits. Wait a few seconds and reload this page."
msgstr "El servidor comprueba la sesión de claude.ai y lee los límites de Claude. Espera unos segundos y vuelve a cargar esta página."

#: scraper/claude_client_views.py:86
msgid "The server will read the Claude limits at the next automatic refresh. If they do not appear, check that the account is connected on the server."
msgstr "El servidor consultará los límites de Claude en la próxima actualización automática. Si no aparecen, comprueba que la cuenta esté conectada en el servidor."

#: scraper/claude_client_views.py:92
#, python-format
msgid "Connect it on the server with: %(command)s."
msgstr "Conéctala en el servidor con: %(command)s."

#: scraper/claude_client_views.py:94
#, python-format
msgid "If the quota does not appear, check the session on the server with: %(command)s."
msgstr "Si la cuota no aparece, comprueba la sesión en el servidor con: %(command)s."

#: scraper/claude_client_views.py:102
msgid "The server is checking the claude.ai session. Wait a few seconds and reload this page."
msgstr "El servidor está comprobando la sesión de claude.ai. Espera unos segundos y vuelve a cargar esta página."

#: scraper/claude_client_views.py:105
msgid "The server will check it at the next automatic refresh."
msgstr "El servidor lo comprobará en la próxima actualización automática."

