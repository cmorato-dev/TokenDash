msgid "Unknown action."
msgstr "Acción desconocida."

#: scraper/codex_oauth.py:37
msgid "The connection with ChatGPT has expired. Sign in again in \"Connect accounts\"."
msgstr "La conexión con ChatGPT ha caducado. Vuelve a iniciar sesión en «Conectar cuentas»."

#: scraper/codex_oauth.py:41
msgid "ChatGPT refused the usage request from the server. The latest data is kept."
msgstr "ChatGPT ha rechazado la consulta de uso desde el servidor. Se conservan los últimos datos."

#: scraper/codex_oauth.py:45
msgid "ChatGPT could not be reached. It will be retried automatically."
msgstr "No se ha podido contactar con ChatGPT. Se reintentará automáticamente."

#: scraper/codex_oauth.py:100
msgid "The pasted address is too long."
msgstr "La dirección pegada es demasiado larga."

#: scraper/codex_oauth.py:103
msgid "Paste the full address of the tab, which starts with http://localhost:1455/auth/callback."
msgstr "Pega la dirección completa de la pestaña, que empieza por http://localhost:1455/auth/callback."

#: scraper/codex_oauth.py:106
msgid "ChatGPT did not authorise the access. Try again."
msgstr "ChatGPT no ha autorizado el acceso. Vuelve a intentarlo."

#: scraper/codex_oauth.py:109
msgid "The pasted address does not contain the authorisation code."
msgstr "La dirección pegada no contiene el código de autorización."

#: scraper/codex_oauth.py:147
msgid "ChatGPT did not accept the code. Codes expire in a few minutes: sign in again and paste the address straight away."
msgstr "ChatGPT no ha aceptado el código. Los códigos caducan en pocos minutos: inicia sesión de nuevo y pega la dirección enseguida."

#: scraper/codex_views.py:41
msgid "The ChatGPT sign-in has opened in another tab. When you finish, copy the address of that tab and paste it here."
msgstr "Se ha abierto el inicio de sesión de ChatGPT en otra pestaña. Cuando termines, copia la dirección de esa pestaña y pégala aquí."

#: scraper/codex_views.py:46
msgid "The sign-in has expired. Press \"Sign in with ChatGPT\" again."
msgstr "El inicio de sesión ha caducado. Pulsa de nuevo «Iniciar sesión con ChatGPT»."

#: scraper/codex_views.py:50
msgid "The pasted address does not belong to this sign-in. Start again."
msgstr "La dirección pegada no corresponde a este inicio de sesión. Vuelve a empezar."

#: scraper/codex_views.py:62
msgid "ChatGPT connected. The Codex limits are being read; after that they refresh on their own."
msgstr "ChatGPT conectado. Estamos leyendo los límites de Codex; después se actualizarán solos."

#: scraper/codex_views.py:64
msgid "ChatGPT connected. The queue is not available now; the limits will be read at the next refresh."
msgstr "ChatGPT conectado. La cola no está disponible ahora; los límites se leerán en la próxima actualización."

#: scraper/codex_views.py:72
msgid "ChatGPT disconnected and its credential deleted from TokenDash. Earlier readings are kept."
msgstr "ChatGPT desconectado y credencial eliminada de TokenDash. Se conservan las lecturas anteriores."

