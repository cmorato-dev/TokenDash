#: templates/admin/dashboard/integrationkey/created.html:7
#, python-format
msgid "Key \"%(name)s\" created"
msgstr "Clave «%(name)s» creada"

#: templates/admin/dashboard/integrationkey/created.html:8
msgid "<strong>Copy it now: it will not be shown again.</strong> If you lose it, delete this key and create another. The key can only read the limits; it cannot refresh, connect or change anything."
msgstr "<strong>Cópiala ahora: no se volverá a mostrar.</strong> Si la pierdes, borra esta clave y crea otra. La clave solo permite leer los límites; no puede actualizar, conectar ni cambiar nada."

#: templates/admin/dashboard/integrationkey/created.html:11
msgid "Modules for a “Webpage” card"
msgstr "Módulos para una tarjeta «Página web»"

#: templates/admin/dashboard/integrationkey/created.html:12
msgid "Each module stands on its own: add to Home Assistant only the ones you want, each on its own card. The key goes after the <code>#</code>, so the browser does not send it to the server and it does not end up in its logs."
msgstr "Cada módulo es independiente: añade en Home Assistant solo los que quieras, cada uno en su propia tarjeta. La clave va detrás de <code>#</code>, así que el navegador no la envía al servidor ni queda en sus registros."

#: templates/admin/dashboard/integrationkey/created.html:14 templates/dashboard/_history.html:5 templates/dashboard/embed.html:11
msgid "Limits over time"
msgstr "Evolución de los límites"

#: templates/admin/dashboard/integrationkey/created.html:16
msgid "The chart opens on 7 days; for another period add <code>?days=30</code> before the <code>#</code> (7, 30, 90, 182, 365 and 1825 are valid)."
msgstr "La gráfica abre en 7 días; para otro periodo añade <code>?days=30</code> antes del <code>#</code> (valen 7, 30, 90, 182, 365 y 1825)."

#: templates/admin/dashboard/integrationkey/created.html:18
msgid "Sensors (optional)"
msgstr "Sensores (opcional)"

#: templates/admin/dashboard/integrationkey/created.html:19
msgid "To have the percentages as Home Assistant entities (automations, history, your own cards), each provider has its own address. It is requested with the <code>Authorization: Bearer</code> header and the key; the configuration examples are in <code>docs/HOME_ASSISTANT.md</code>."
msgstr "Para tener los porcentajes como entidades de Home Assistant (automatizaciones, historial, tarjetas propias), cada proveedor tiene su dirección. Se pide con la cabecera <code>Authorization: Bearer</code> y la clave; los ejemplos de configuración están en <code>docs/es/HOME_ASSISTANT.md</code>."

#: templates/admin/dashboard/integrationkey/created.html:24
msgid "Done"
msgstr "Hecho"

